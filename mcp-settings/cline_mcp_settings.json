{
  "//about": "Production-Grade MCP Configuration for Cline + Omniroute + OpenRouter",
  "//docs": "https://github.com/modelcontextprotocol/servers",

  "mcpServers": {
    "filesystem": {
      "description": "File operations for workspace directories",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\navee\\OneDrive\\Documents\\Code"
      ],
      "disabled": false
    },

    "memory": {
      "description": "Persistent knowledge graph for cross-session context - reduces token usage by storing project knowledge",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "C:\\Users\\navee\\OneDrive\\Documents\\Code\\Cline-StarterKit\\.cline\\memory.jsonl"
      },
      "disabled": false
    },

    "sequential-thinking": {
      "description": "Structured problem-solving for complex tasks - improves reasoning quality",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "disabled": false
    },

    "git": {
      "description": "Git operations without shell commands - more efficient than CLI",
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "C:\\Users\\navee\\OneDrive\\Documents\\Code\\Cline-StarterKit"
      ],
      "disabled": false
    },

    "fetch": {
      "description": "Web content fetching for documentation and API references",
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ],
      "disabled": false
    }
  }
}
